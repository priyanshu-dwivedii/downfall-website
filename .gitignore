# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.production
.env.development
.env.test
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch & local testing
/test_*.js
/test_*.html
/preview.html
/public/uploads/*

# local catalog backups, credentials, migration manifests & recordings
/src/data/auth-store.json
/src/data/backups/
/src/data/*.backup.json
/src/data/migration-manifest.json
/src/data/draft-images-manifest.json
*.webm
*.webp
/archive/

