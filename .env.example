# DOWNFALL Client WhatsApp Destination (International Format, e.g. 91XXXXXXXXXX)
NEXT_PUBLIC_DOWNFALL_WHATSAPP=917415430076

# Supabase Project Configuration (Obtain from Supabase Project Settings -> API)
# Required for Netlify cloud database, image storage, and persistent authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Explicit Admin Authorization (Comma-separated authorized admin emails)
ADMIN_EMAILS=admin@downfall.in,owner@downfall.in

# Emergency Fallback Admin Credentials (For local offline testing & break-glass access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_16_char_password_here
ADMIN_SESSION_SECRET=your_32_char_random_hmac_secret_here
